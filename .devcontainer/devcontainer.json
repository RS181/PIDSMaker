{
  "name": "PIDSMaker Dev Container",
  "dockerComposeFile": ["../compose-pidsmaker.yml"],
  "service": "pids",
  "workspaceFolder": "/home/pids",
  "forwardPorts": ["${env:DOCKER_PORT}"],
  "remoteUser": "pids",
  // ADDED: Forces the extension to use the already-built local image 
  // without re-running 'docker compose build' under the hood.
  "runServices": ["pids"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode-remote.remote-containers",
        "nvidia.nsight-vscode-edition", // For CUDA/GPU debugging
        "eamodio.gitlens",
        "ms-toolsai.jupyter",
        "anthropic.claude-code"
      ]
    }
  },
  "mounts": [],
  // Keep containers running after VS Code closes
  "shutdownAction": "none"
}